# ==========================================
# Docker Compose / Local PostgreSQL (Optional)
# ==========================================
APP_PORT=3090
POSTGRES_PORT=5439
POSTGRES_USER=stocklight
POSTGRES_PASSWORD=stocklight_dev
POSTGRES_DB=stocklight
# Used automatically by docker-compose.yml; set manually only if running outside Docker
# DATABASE_URL=postgresql://stocklight:stocklight_dev@localhost:5439/stocklight

# ==========================================
# Supabase (Database + Auth SSO) — Optional
# ==========================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_SSO_DOMAIN=yourcompany.com

# ==========================================
# Cloudflare R2 (Object Storage for Photos) — Optional
# ==========================================
# CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# CLOUDFLARE_R2_BUCKET_NAME=stock-light-photos
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
