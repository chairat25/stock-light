# ==========================================
# Supabase (Database + Auth SSO)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Enterprise SSO domain configured in Supabase Auth
# NEXT_PUBLIC_SSO_DOMAIN=yourcompany.com

# ==========================================
# Cloudflare R2 (Object Storage for Photos)
# ==========================================
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=stock-light-photos

# Public URL of your Cloudflare R2 bucket or custom domain (no trailing slash)
# Example: https://photos.yourdomain.com or https://pub-xxxx.r2.dev
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
